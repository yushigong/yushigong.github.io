  padding-top: 24px;
}

body.dpod-redesign-case-page .ccc-measure-next > div {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

body.dpod-redesign-case-page .ccc-measure-next strong {
  display: inline-flex;
  padding: 10px 14px;
