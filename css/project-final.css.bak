  justify-content: center;
  color: var(--ccc-coral);
  font-size: 38px;
}

body.dpod-redesign-case-page .ccc-mini-flow {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin: 22px 0 16px;
}

body.dpod-redesign-case-page .ccc-mini-flow span {
  text-align: center;
  padding: 12px 8px;
  border: 1px solid var(--ccc-border);
