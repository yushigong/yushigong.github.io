/* v37 — final project-page alignment fixes */
@media (min-width: 1001px) {
  /* Keep every wide project element on one shared canvas. */
  body.case-study-redesign .site-nav.page-shell,
  body.case-study-redesign .site-footer.page-shell,
  body.case-study-redesign .case-header-section-container,
  body.case-study-redesign .case-meta-wrap,
  body.case-study-redesign .case-study-wider-container,
  body.case-study-redesign .other-projects-section {
    width: min(1220px, calc(100% - 144px)) !important;
    max-width: none !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Navigation matches the homepage's final desktop type scale. */
  body.case-study-redesign .site-nav.page-shell {
    min-height: 76px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
  }
  body.case-study-redesign .site-nav .wordmark {
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 17px !important;
    line-height: 1 !important;
    font-weight: 800 !important;
    letter-spacing: -0.045em !important;
  }
  body.case-study-redesign .site-nav .nav-links {
    display: flex !important;
    align-items: center !important;
    gap: 46px !important;
  }
  body.case-study-redesign .site-nav .nav-links a {
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 14px !important;
    line-height: 1 !important;
    font-weight: 600 !important;
    letter-spacing: 0.055em !important;
  }

  /* Give the title block a little more air above and below. */
  body.case-study-redesign .case-header-section-container {
    padding-top: 64px !important;
  }
  body.case-study-redesign .case-project-meta {
    margin-bottom: 20px !important;
  }
  body.case-study-redesign .case-study-largest-header {
    margin-top: 0 !important;
    margin-bottom: 24px !important;
  }
  body.case-study-redesign .case-study-large-header1 {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  body.case-study-redesign .case-header-section-container > .large-spacing {
    display: block !important;
    height: 58px !important;
  }

  /* Other-project metadata: same color, weight and type treatment throughout. */
  body.case-study-redesign .other-projects-section .design-date,
  body.case-study-redesign .other-projects-section .design-date > span {
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 16px !important;
    line-height: 1.35 !important;
    font-weight: 500 !important;
    letter-spacing: 0 !important;
    color: #777 !important;
  }
  body.case-study-redesign .other-projects-section .design-date {
    display: flex !important;
    align-items: center !important;
    flex-wrap: wrap !important;
    gap: 14px !important;
  }
  body.case-study-redesign .other-projects-section .design-date .meta-rule {
    flex: 0 0 40px !important;
    width: 40px !important;
    height: 1px !important;
    background: #aaa !important;
    opacity: 1 !important;
  }

  /* Homepage footer geometry and typography, with the links centered on the email line. */
  body.case-study-redesign .site-footer.page-shell {
    min-height: 330px !important;
    padding-top: 88px !important;
    padding-bottom: 56px !important;
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) auto !important;
    column-gap: 64px !important;
    align-items: stretch !important;
  }
  body.case-study-redesign .site-footer > div:first-child,
  body.case-study-redesign .site-footer .footer-right {
    min-height: 186px !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    box-sizing: border-box !important;
  }
  body.case-study-redesign .site-footer > div:first-child {
    align-items: flex-start !important;
  }
  body.case-study-redesign .site-footer .footer-right {
    align-items: flex-end !important;
  }
  body.case-study-redesign .site-footer .footer-kicker {
    margin: 0 0 23px !important;
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 13px !important;
    line-height: 1 !important;
    font-weight: 400 !important;
    letter-spacing: 0.095em !important;
  }
  body.case-study-redesign .site-footer .footer-email {
    margin: 0 !important;
    font-family: "Inter Tight", "Inter", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 42px !important;
    line-height: 1.05 !important;
    font-weight: 750 !important;
    letter-spacing: -0.04em !important;
  }
  body.case-study-redesign .site-footer .footer-links {
    margin-top: 49px !important;
    display: flex !important;
    align-items: center !important;
    gap: 44px !important;
  }
  body.case-study-redesign .site-footer .footer-links a {
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 14px !important;
    line-height: 1 !important;
    font-weight: 600 !important;
    letter-spacing: 0.075em !important;
  }
  body.case-study-redesign .site-footer .copyright,
  body.case-study-redesign .site-footer .footer-right > p {
    margin-top: auto !important;
    margin-bottom: 0 !important;
    font-family: "Inter", "Helvetica Neue", Arial, sans-serif !important;
    font-size: 12px !important;
    line-height: 1 !important;
    font-weight: 400 !important;
  }
}

/* DPoD Quorum case-study refinements */
body.quorum-case-page .quorum-meta-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  gap: 24px !important;
}

body.quorum-case-page .quorum-meta-grid .case-meta-item {
  min-width: 0;
}

body.quorum-case-page .case-study-subheading {
  margin: 42px 0 0;
  font-family: "Inter Tight", "Inter", "Helvetica Neue", Arial, sans-serif;
  font-size: 22px;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #1f1f1f;
}

body.quorum-case-page .case-study-paragraph + .case-study-paragraph {
  margin-top: 26px !important;
}

body.dpod-redesign-case-page .ccc-rounded-visual {
  overflow: hidden;
  border-radius: 22px;
  box-shadow: 0 24px 70px rgba(24, 31, 82, 0.10);
}

/* Keep a clear blank line between consecutive paragraphs on every case study. */
body.case-study-redesign.unified-case-page .case-study-paragraph + .case-study-paragraph {
  margin-top: 26px !important;
}

body.quorum-case-page .quorum-tight-heading + img,
body.quorum-case-page img.quorum-tight-visual {
  margin-top: 16px !important;
}

body.quorum-case-page .quorum-visual-wide {
  position: relative;
  left: 50%;
  width: min(1180px, calc(100vw - 48px)) !important;
  max-width: none !important;
  transform: translateX(-50%);
}

body.quorum-case-page .quorum-flow-visual {
  width: min(1320px, calc(100vw - 32px)) !important;
}

body.quorum-case-page .case-study-motion {
  display: block;
  width: 100%;
  height: auto;
  margin: 42px 0 0;
  vertical-align: top;
  background: #f8f7f6;
}

body.quorum-case-page .quorum-cover-motion {
  display: block;
  width: 100%;
  height: auto;
  margin: 0;
  vertical-align: top;
  background: #f1f0ef;
}

body.quorum-case-page .hmw-band-initial {
  min-height: 440px !important;
  background: #f5f3f2 !important;
  color: #171717 !important;
}

body.quorum-case-page .hmw-band-initial .hmw-inner {
  padding-top: 96px !important;
  padding-bottom: 96px !important;
}

body.quorum-case-page .hmw-band-initial .hmw-inner h2 {
  color: #171717 !important;
}

body.quorum-case-page .quorum-impact-grid,
body.dpod-redesign-case-page .quorum-impact-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin: 42px 0 48px;
}

body.quorum-case-page .quorum-impact-item,
body.dpod-redesign-case-page .quorum-impact-item {
  min-height: 150px;
  padding: 28px 24px;
  border-top: 4px solid #ff6f67;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 12px 34px rgba(30, 30, 30, 0.08);
}

body.quorum-case-page .quorum-impact-item strong,
body.quorum-case-page .quorum-impact-item span,
body.dpod-redesign-case-page .quorum-impact-item strong,
body.dpod-redesign-case-page .quorum-impact-item span {
  display: block;
}

body.quorum-case-page .quorum-impact-item strong,
body.dpod-redesign-case-page .quorum-impact-item strong {
  margin-bottom: 12px;
  font-family: "Inter Tight", "Inter", "Helvetica Neue", Arial, sans-serif;
  font-size: 38px;
  line-height: 1;
  font-weight: 750;
  letter-spacing: -0.04em;
  color: #1f1f1f;
}

body.quorum-case-page .quorum-impact-item span,
body.dpod-redesign-case-page .quorum-impact-item span {
  font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
  font-size: 14px;
  line-height: 1.45;
  color: #595959;
}

@media (max-width: 1100px) {
  body.quorum-case-page .quorum-meta-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 760px) {
  body.quorum-case-page .quorum-meta-grid,
  body.quorum-case-page .quorum-impact-grid,
  body.dpod-redesign-case-page .quorum-impact-grid {
    grid-template-columns: 1fr !important;
  }

  body.quorum-case-page .quorum-visual-wide,
  body.quorum-case-page .quorum-flow-visual {
    width: calc(100vw - 24px) !important;
  }

  body.quorum-case-page .quorum-impact-item,
  body.dpod-redesign-case-page .quorum-impact-item {
    min-height: 0;
  }
}

/* DPoD redesign — contextual editorial visuals and motion */
body.dpod-redesign-case-page .case-study-section-info-container > img,
body.dpod-redesign-case-page .case-study-section-info-container-image-below > img {
  display: block;
  width: min(900px, 100%) !important;
  margin-left: 0 !important;
  margin-right: auto !important;
}

body.dpod-redesign-case-page .case-study-section-info-container > img.ccc-problem-visual,
body.dpod-redesign-case-page .case-study-section-info-container-image-below > img.ccc-problem-visual {
  width: min(1180px, calc(100vw - 64px)) !important;
}

body.dpod-redesign-case-page .ccc-motion {
  width: min(1040px, calc(100vw - 96px));
  max-width: none;
  margin: 48px 50% 0;
  transform: translateX(-50%);
  position: relative;
}

body.dpod-redesign-case-page .ccc-motion img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 !important;
}

body.dpod-redesign-case-page .ccc-audit-panels {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
}

body.dpod-redesign-case-page .ccc-audit-panels img {
  min-width: 0;
}

body.dpod-redesign-case-page .ccc-audit-mobile {
  display: none;
}

body.dpod-redesign-case-page .ccc-figma-motion,
body.dpod-redesign-case-page .ccc-audit-motion,
body.dpod-redesign-case-page .ccc-component-motion,
body.dpod-redesign-case-page .ccc-impact-motion {
  overflow: hidden;
  border-radius: 22px;
  background: #f8f8ff;
  box-shadow: 0 24px 70px rgba(24, 31, 82, .10);
}

/* The audit artwork already contains its own soft gradient. Keep the shared
   radius and add elevation below the artwork only. */
body.dpod-redesign-case-page .ccc-audit-motion {
  margin-top: 8px !important;
  overflow: hidden !important;
  background: transparent;
  border-radius: 22px !important;
  box-shadow: none;
  clip-path: inset(0 round 22px);
  filter: drop-shadow(0 17px 30px rgba(24, 31, 82, .12));
  isolation: isolate;
}

body.dpod-redesign-case-page .ccc-audit-motion > img {
  border-radius: inherit;
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-audit-motion {
  opacity: .92;
  transform: translateX(-50%) translateY(18px) scale(.985);
  transition:
    opacity 850ms cubic-bezier(.16,1,.3,1),
    transform 1050ms cubic-bezier(.16,1,.3,1);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-audit-motion.is-in {
  opacity: 1;
  transform: translateX(-50%) scale(1);
}

body.dpod-redesign-case-page .ccc-component-motion img {
  transform: translate3d(0, var(--ccc-parallax-y, 0), 0) scale(1.025);
  transition: transform 180ms linear;
}

body.dpod-redesign-case-page .ccc-workflow-gallery {
  width: min(1180px, calc(100vw - 64px));
  max-width: none;
  margin: 56px 50% 0;
  transform: translateX(-50%);
}

body.dpod-redesign-case-page .ccc-workflow {
  width: 100%;
  margin: 0 0 88px;
}

body.dpod-redesign-case-page .ccc-workflow:last-child {
  margin-bottom: 0;
}

body.dpod-redesign-case-page .ccc-workflow h2 {
  margin: 0 0 15px;
  padding-left: 4px;
  color: #62677c;
  font-family: "Inter", sans-serif;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: .13em;
  line-height: 1.4;
  text-transform: uppercase;
}

body.dpod-redesign-case-page .ccc-workflow h2 span {
  display: inline-block;
  margin-right: 10px;
  color: #7567e8;
}

body.dpod-redesign-case-page .ccc-workflow img {
  display: block;
  width: 100%;
  height: auto;
  margin: 0 !important;
  border-radius: 22px;
  box-shadow: 0 24px 70px rgba(24, 31, 82, .10);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-audit-panels img {
  opacity: .92;
  transform: translate3d(0, 18px, 0);
  transition:
    opacity 700ms cubic-bezier(.16,1,.3,1),
    transform 900ms cubic-bezier(.16,1,.3,1);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-audit-motion.is-in .ccc-audit-panels img {
  opacity: 1;
  transform: none;
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-audit-motion.is-in .ccc-audit-panels img:nth-child(2) {
  transition-delay: 150ms;
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-audit-motion.is-in .ccc-audit-panels img:nth-child(3) {
  transition-delay: 300ms;
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-figma-motion {
  opacity: .92;
  transform: translateX(-50%) translateY(18px) scale(.985);
  transition:
    opacity 850ms cubic-bezier(.16,1,.3,1),
    transform 1150ms cubic-bezier(.16,1,.3,1);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-figma-motion.is-in {
  opacity: 1;
  transform: translateX(-50%) scale(1);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-component-motion {
  opacity: 0;
  transform: translateX(-50%) translateY(42px);
  transition:
    opacity 850ms cubic-bezier(.16,1,.3,1),
    transform 1050ms cubic-bezier(.16,1,.3,1);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-component-motion.is-in {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-workflow {
  opacity: .94;
  transition:
    opacity 780ms cubic-bezier(.16,1,.3,1),
    transform 1100ms cubic-bezier(.16,1,.3,1);
  will-change: opacity, transform;
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-motion-from-left {
  transform: translate3d(-18px, 0, 0);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-motion-from-right {
  transform: translate3d(18px, 0, 0);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-workflow.is-in {
  opacity: 1;
  transform: none;
  will-change: auto;
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-impact-motion {
  opacity: .92;
  transform: translateX(-50%) translateY(18px) scale(.985);
  transition:
    opacity 850ms cubic-bezier(.16,1,.3,1),
    transform 1150ms cubic-bezier(.16,1,.3,1);
}

.ccc-motion-enabled body.dpod-redesign-case-page .ccc-impact-motion.is-in {
  opacity: 1;
  transform: translateX(-50%) scale(1);
}

@media (max-width: 800px) {
  body.dpod-redesign-case-page .case-study-section-info-container > img.ccc-problem-visual,
  body.dpod-redesign-case-page .case-study-section-info-container-image-below > img.ccc-problem-visual {
    width: calc(100vw - 32px) !important;
  }

  body.dpod-redesign-case-page .ccc-motion,
  body.dpod-redesign-case-page .ccc-workflow-gallery {
    width: calc(100vw - 32px);
  }

  body.dpod-redesign-case-page .ccc-audit-panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  body.dpod-redesign-case-page .ccc-audit-mobile {
    display: none;
  }

  body.dpod-redesign-case-page .ccc-workflow {
    margin-bottom: 54px;
  }

  body.dpod-redesign-case-page .ccc-workflow h2 {
    margin-bottom: 12px;
    font-size: 12px;
  }

  body.dpod-redesign-case-page .ccc-workflow img,
  body.dpod-redesign-case-page .ccc-figma-motion,
  body.dpod-redesign-case-page .ccc-component-motion,
  body.dpod-redesign-case-page .ccc-impact-motion {
    border-radius: 14px;
  }

}

@media (prefers-reduced-motion: reduce) {
  .ccc-motion-enabled body.dpod-redesign-case-page .ccc-motion,
  .ccc-motion-enabled body.dpod-redesign-case-page .ccc-audit-panels img,
  .ccc-motion-enabled body.dpod-redesign-case-page .ccc-audit-mobile,
  .ccc-motion-enabled body.dpod-redesign-case-page .ccc-workflow {
    opacity: 1;
    clip-path: none;
    filter: none;
    transition: none;
  }

  .ccc-motion-enabled body.dpod-redesign-case-page .ccc-motion {
    transform: translateX(-50%);
  }

  .ccc-motion-enabled body.dpod-redesign-case-page .ccc-workflow {
    transform: none;
  }

  body.dpod-redesign-case-page .ccc-component-motion img {
    transform: none;
    transition: none;
  }
}

/* ===== DPoD redesign 2026 story refresh ===== */
body.dpod-redesign-case-page {
  --ccc-coral: #ef6252;
  --ccc-ink: #111111;
  --ccc-muted: #696969;
  --ccc-panel: #f7f7f6;
  --ccc-blush: #fbf1ef;
  --ccc-border: #e8e8e5;
}

body.dpod-redesign-case-page .ccc-value-grid,
body.dpod-redesign-case-page .ccc-three-column-grid,
body.dpod-redesign-case-page .ccc-impact-grid-new {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  margin-top: 42px;
}

body.dpod-redesign-case-page .ccc-value-item,
body.dpod-redesign-case-page .ccc-impact-grid-new > div {
  min-height: 165px;
  border: 1px solid var(--ccc-border);
  border-radius: 18px;
  background: #fff;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

body.dpod-redesign-case-page .ccc-value-item strong,
body.dpod-redesign-case-page .ccc-impact-grid-new strong {
  display: block;
  font-family: 'Inter Tight', 'Inter', sans-serif;
  font-size: clamp(34px, 4vw, 58px);
  line-height: .96;
  letter-spacing: -0.045em;
  color: var(--ccc-coral);
  margin-bottom: 12px;
}

body.dpod-redesign-case-page .ccc-value-item span,
body.dpod-redesign-case-page .ccc-impact-grid-new > div > span {
  font-size: 12px;
  line-height: 1.35;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--ccc-muted);
  font-weight: 700;
}

body.dpod-redesign-case-page .ccc-insight-card {
  position: relative;
  border: 1px solid var(--ccc-border);
  border-radius: 18px;
  background: #fff;
  padding: 30px 28px 28px;
  min-height: 310px;
}

body.dpod-redesign-case-page .ccc-insight-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 28px;
  right: 28px;
  height: 3px;
  border-radius: 999px;
  background: var(--ccc-coral);
}

body.dpod-redesign-case-page .ccc-card-label,
body.dpod-redesign-case-page .ccc-hmw-goals span,
body.dpod-redesign-case-page .ccc-two-value-grid span,
body.dpod-redesign-case-page .ccc-redesign-principles > div > span,
body.dpod-redesign-case-page .ccc-measure-next > span {
  display: block;
  color: var(--ccc-coral);
  font-size: 12px;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  margin-bottom: 14px;
}

body.dpod-redesign-case-page .ccc-card-number {
  display: inline-block;
  margin-right: 8px;
  color: #a7a7a2;
  font-size: 12px;
  font-weight: 700;
}

body.dpod-redesign-case-page .ccc-insight-card h2 {
  font-family: 'Inter Tight', 'Inter', sans-serif;
  font-size: 24px;
  line-height: 1.15;
  letter-spacing: -.025em;
  margin: 0 0 14px;
  color: var(--ccc-ink);
}

body.dpod-redesign-case-page .ccc-insight-card p,
body.dpod-redesign-case-page .ccc-two-value-grid p,
body.dpod-redesign-case-page .ccc-redesign-principles p,
body.dpod-redesign-case-page .ccc-system-side p,
body.dpod-redesign-case-page .ccc-impact-grid-new p {
  font-size: 16px;
  line-height: 1.6;
  color: var(--ccc-muted);
  margin: 0;
}

body.dpod-redesign-case-page .ccc-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 22px;
}

body.dpod-redesign-case-page .ccc-chip-row span {
  font-size: 12px;
  line-height: 1;
  padding: 9px 11px;
  border-radius: 999px;
  background: var(--ccc-blush);
  color: #7b4b45;
  white-space: nowrap;
}

body.dpod-redesign-case-page .ccc-takeaway {
  margin-top: 34px;
  padding: 22px 26px;
  border-left: 4px solid var(--ccc-coral);
  background: var(--ccc-blush);
  border-radius: 0 14px 14px 0;
  color: var(--ccc-ink);
  font-size: 18px;
  line-height: 1.55;
}

body.dpod-redesign-case-page .ccc-takeaway strong,
body.dpod-redesign-case-page .ccc-takeaway span {
  display: block;
}

body.dpod-redesign-case-page .ccc-takeaway span {
  margin-top: 4px;
  color: var(--ccc-muted);
}

body.dpod-redesign-case-page .ccc-hmw-band {
  background: #111;
}

body.dpod-redesign-case-page .ccc-hmw-band .case-study-small-header,
body.dpod-redesign-case-page .ccc-hmw-band .section-number,
body.dpod-redesign-case-page .ccc-hmw-band .section-name,
body.dpod-redesign-case-page .ccc-hmw-band .section-rule {
  color: #fff;
  border-color: rgba(255,255,255,.35);
}

body.dpod-redesign-case-page .ccc-hmw-kicker {
  margin-top: 40px;
  color: var(--ccc-coral);
  font-size: 13px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: .12em;
}

body.dpod-redesign-case-page .ccc-hmw-band h2 {
  max-width: 1050px;
  margin: 16px auto 0;
  color: #fff;
}

body.dpod-redesign-case-page .ccc-hmw-goals {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin: 44px auto 0;
  max-width: 1120px;
}

body.dpod-redesign-case-page .ccc-hmw-goals > div {
  border-top: 1px solid rgba(255,255,255,.28);
  padding-top: 18px;
}

body.dpod-redesign-case-page .ccc-hmw-goals strong {
  display: block;
  color: #fff;
  font-size: 16px;
  line-height: 1.45;
  font-weight: 600;
}

body.dpod-redesign-case-page .ccc-hmw-goals span {
  margin-bottom: 10px;
}

body.dpod-redesign-case-page .ccc-redesign-principles {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin: 38px 0 46px;
}

body.dpod-redesign-case-page .ccc-redesign-principles > div,
body.dpod-redesign-case-page .ccc-two-value-grid > div {
  padding: 26px;
  border-radius: 16px;
  background: var(--ccc-panel);
  border: 1px solid var(--ccc-border);
}

body.dpod-redesign-case-page .ccc-redesign-principles strong,
body.dpod-redesign-case-page .ccc-two-value-grid strong,
body.dpod-redesign-case-page .ccc-system-side strong {
  display: block;
  font-family: 'Inter Tight', 'Inter', sans-serif;
  color: var(--ccc-ink);
  font-size: 21px;
  line-height: 1.2;
  letter-spacing: -.02em;
  margin-bottom: 10px;
}

body.dpod-redesign-case-page .ccc-workflow-gallery-compact {
  margin-top: 20px;
}

body.dpod-redesign-case-page .ccc-system-shift {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 24px;
  align-items: stretch;
  margin: 42px 0 22px;
}

body.dpod-redesign-case-page .ccc-system-side {
  border: 1px solid var(--ccc-border);
  border-radius: 18px;
  padding: 28px;
  background: #fff;
}

body.dpod-redesign-case-page .ccc-system-side-after {
  background: var(--ccc-blush);
  border-color: #f0d3cf;
}

body.dpod-redesign-case-page .ccc-system-arrow {
  display: flex;
