body.dpod-redesign-case-page .ccc-audit-number,
body.dpod-redesign-case-page .ccc-audit-result span {
  display:block; color:#ef6252; font-size:12px; font-weight:800; letter-spacing:.12em; text-transform:uppercase;
}
body.dpod-redesign-case-page .ccc-audit-origin strong { display:block; margin-top:9px; font-size:24px; line-height:1.25; color:#171717; }
body.dpod-redesign-case-page .ccc-audit-origin p { max-width:650px; margin:10px auto 0; color:#666; font-size:15px; line-height:1.55; }
body.dpod-redesign-case-page .ccc-audit-paths { display:grid; grid-template-columns:1fr 1fr; gap:22px; }
body.dpod-redesign-case-page .ccc-audit-path { min-height:168px; padding:30px 32px; border:1px solid #dedbd8; border-radius:16px; background:#fff; text-align:center; }
body.dpod-redesign-case-page .ccc-audit-path strong { display:block; margin:10px auto 12px; font-size:20px; line-height:1.3; color:#171717; }
body.dpod-redesign-case-page .ccc-audit-path p { margin:0 auto; max-width:420px; color:#696969; font-size:14px; line-height:1.6; }
body.dpod-redesign-case-page .ccc-audit-branches,
body.dpod-redesign-case-page .ccc-audit-merge { position:relative; height:54px; max-width:58%; margin:0 auto; }
body.dpod-redesign-case-page .ccc-audit-branches i,
body.dpod-redesign-case-page .ccc-audit-merge i { position:absolute; left:50%; top:0; width:1px; height:28px; background:#ef6252; }
body.dpod-redesign-case-page .ccc-audit-branches span,
body.dpod-redesign-case-page .ccc-audit-merge span { position:absolute; top:27px; width:50%; height:1px; background:#ef6252; }
body.dpod-redesign-case-page .ccc-audit-branches span:first-child,
body.dpod-redesign-case-page .ccc-audit-merge span:first-child { left:0; }
body.dpod-redesign-case-page .ccc-audit-branches span:last-child,
body.dpod-redesign-case-page .ccc-audit-merge span:last-child { right:0; }
body.dpod-redesign-case-page .ccc-audit-branches span:first-child:after,
body.dpod-redesign-case-page .ccc-audit-branches span:last-child:after { content:""; position:absolute; top:0; width:1px; height:27px; background:#ef6252; }
body.dpod-redesign-case-page .ccc-audit-branches span:first-child:after { left:0; }
body.dpod-redesign-case-page .ccc-audit-branches span:last-child:after { right:0; }
body.dpod-redesign-case-page .ccc-audit-merge { transform:rotate(180deg); margin-top:0; }
body.dpod-redesign-case-page .ccc-audit-result { padding-top:2px; }
body.dpod-redesign-case-page .ccc-audit-result strong { display:block; margin-top:8px; font-size:22px; line-height:1.3; color:#171717; }
body.dpod-redesign-case-page .ccc-impact-at-glance { width:100%; max-width:none; margin-left:0; margin-right:0; }
body.dpod-redesign-case-page .ccc-impact-closing { width:100%; max-width:100%; text-align:center; margin:30px auto 0; }
@media (max-width:767px) {
