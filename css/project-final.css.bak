}

body.dpod-redesign-case-page .ccc-impact-grid-new > div > span {
  margin-bottom: 18px;
}

body.dpod-redesign-case-page .ccc-impact-grid-new strong {
  margin-bottom: 12px;
}

body.dpod-redesign-case-page .ccc-impact-grid-new h2 {
  font-family: 'Inter Tight', 'Inter', sans-serif;
  font-size: 24px;
