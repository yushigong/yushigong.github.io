}
body.dpod-redesign-case-page .ccc-audit-3col p {
  margin:0 0 18px;
  color:#666;
  font-size:14px;
  line-height:1.6;
}
body.dpod-redesign-case-page .ccc-audit-3col article > strong {
  display:block;
  margin-top:auto;
  padding-top:18px;
  border-top:1px solid #ece9e6;
  color:#171717;
  font-size:14px;
  line-height:1.45;
}
body.dpod-redesign-case-page .ccc-scope-callout {
  margin-top:24px;
  padding:30px 32px;
  border:1px solid #ead9d4;
  border-left:4px solid var(--ccc-coral);
  border-radius:14px;
  background:#fff8f6;
}
body.dpod-redesign-case-page .ccc-scope-callout h2 {
  margin:10px 0 10px;
  font-size:22px;
  color:#171717;
}
body.dpod-redesign-case-page .ccc-scope-callout p {
  margin:0;
  color:#5f5f5f;
  font-size:15px;
  line-height:1.65;
}
body.dpod-redesign-case-page .ccc-scope-callout > strong {
  display:block;
  margin-top:16px;
  color:#171717;
  font-size:15px;
}

body.dpod-redesign-case-page .ccc-system-loop {
  display:grid;
  grid-template-columns:repeat(7,auto);
  align-items:stretch;
  gap:10px;
  margin-top:38px;
}
body.dpod-redesign-case-page .ccc-system-loop > div {
  min-width:0;
  padding:22px 20px;
  border:1px solid var(--ccc-border);
  border-radius:14px;
  background:#fff;
}
body.dpod-redesign-case-page .ccc-system-loop > i {
  align-self:center;
  color:var(--ccc-coral);
  font-size:25px;
  font-style:normal;
}
body.dpod-redesign-case-page .ccc-system-loop strong {
  display:block;
  margin-top:8px;
  color:#171717;
  font-size:16px;
  line-height:1.3;
}
body.dpod-redesign-case-page .ccc-system-loop p {
  margin:7px 0 0;
  color:#707070;
  font-size:13px;
  line-height:1.5;
}

body.dpod-redesign-case-page .ccc-decision-block {
  margin-top:78px;
  padding-top:70px;
  border-top:1px solid #ddd9d6;
}
body.dpod-redesign-case-page .ccc-decision-block:first-of-type { margin-top:50px; }
body.dpod-redesign-case-page .ccc-decision-block > h2,
body.dpod-redesign-case-page .ccc-preserve-section > h2 {
  max-width:900px;
  margin:12px 0 18px;
  color:#171717;
  font-size:31px;
  line-height:1.14;
  font-weight:700;
  letter-spacing:-.035em;
}
body.dpod-redesign-case-page .ccc-inline-insight {
  display:flex;
  flex-wrap:wrap;
  gap:6px 16px;
  margin:26px 0 0;
  padding:20px 24px;
  border-left:4px solid var(--ccc-coral);
  background:#fff;
  color:#171717;
  font-size:15px;
}
body.dpod-redesign-case-page .ccc-inline-insight span { color:#666; }

body.dpod-redesign-case-page .ccc-option-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
  margin-top:30px;
}
body.dpod-redesign-case-page .ccc-option-grid > article {
  position:relative;
  padding:28px 30px;
  border:1px solid #ddd9d6;
  border-radius:16px;
  background:#fff;
}
body.dpod-redesign-case-page .ccc-option-grid > article.chosen {
  border-color:#d9aaa0;
  background:#fff8f6;
}
body.dpod-redesign-case-page .ccc-option-grid > article > b {
  position:absolute;
  top:18px;
  right:18px;
  padding:6px 9px;
  border-radius:999px;
  background:#111;
  color:#fff;
  font-size:9px;
  letter-spacing:.1em;
}
body.dpod-redesign-case-page .ccc-option-grid h3 {
  margin:14px 0 22px;
  color:#171717;
  font-size:22px;
  line-height:1.25;
}
body.dpod-redesign-case-page .ccc-option-grid article > div + div { margin-top:18px; }
body.dpod-redesign-case-page .ccc-option-grid article > div > strong {
  display:block;
  margin-bottom:8px;
  color:#171717;
  font-size:13px;
}
body.dpod-redesign-case-page .ccc-option-grid ul {
  margin:0;
  padding-left:19px;
  color:#666;
  font-size:14px;
  line-height:1.6;
}
body.dpod-redesign-case-page .ccc-discussion-callout {
  margin-top:24px;
  padding:25px 28px;
  border-radius:14px;
  background:#f2f1ef;
}
body.dpod-redesign-case-page .ccc-discussion-callout p {
  margin:9px 0 0;
  color:#565656;
  font-size:14px;
  line-height:1.65;
}
body.dpod-redesign-case-page .ccc-decision-line {
  display:flex;
  align-items:flex-start;
  gap:18px;
  margin:26px 0 0;
  padding:20px 24px;
  border-radius:12px;
  background:#111;
  color:#fff;
}
body.dpod-redesign-case-page .ccc-decision-line span {
  flex:none;
  color:#f58b7f;
  font-size:11px;
  font-weight:800;
  letter-spacing:.1em;
  text-transform:uppercase;
}
body.dpod-redesign-case-page .ccc-decision-line strong {
  font-size:15px;
  line-height:1.45;
}
body.dpod-redesign-case-page .ccc-decision-block .ccc-workflow {
  margin-top:38px;
  padding-top:0;
  border-top:0;
}

body.dpod-redesign-case-page .ccc-compact-tradeoff {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
  margin-top:26px;
}
body.dpod-redesign-case-page .ccc-compact-tradeoff > div {
  padding:24px 26px;
  border:1px solid var(--ccc-border);
  border-radius:14px;
  background:#fff;
}
body.dpod-redesign-case-page .ccc-compact-tradeoff > div.chosen {
  border-color:#d9aaa0;
  background:#fff8f6;
}
body.dpod-redesign-case-page .ccc-compact-tradeoff strong {
  display:block;
  margin-top:8px;
  color:#171717;
  font-size:16px;
}
body.dpod-redesign-case-page .ccc-compact-tradeoff p {
  margin:8px 0 0;
  color:#666;
  font-size:13px;
  line-height:1.55;
}

body.dpod-redesign-case-page .ccc-account-placeholder {
  position:relative;
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  gap:24px;
  margin-top:38px;
  padding:30px;
  border:1px dashed #cfc8c4;
  border-radius:18px;
  background:#fff;
}
body.dpod-redesign-case-page .ccc-account-placeholder > div {
  min-height:250px;
  padding:24px;
  border:1px solid var(--ccc-border);
  border-radius:14px;
  background:#faf9f8;
}
body.dpod-redesign-case-page .ccc-account-placeholder > div.after { background:#fff8f6; }
body.dpod-redesign-case-page .ccc-account-placeholder > div > strong {
  display:block;
  margin-top:10px;
  color:#171717;
  font-size:18px;
  line-height:1.3;
}
body.dpod-redesign-case-page .ccc-account-placeholder > b { color:var(--ccc-coral); font-size:28px; }
body.dpod-redesign-case-page .ccc-account-placeholder > small {
  position:absolute;
  left:0; right:0; bottom:10px;
  text-align:center;
  color:#999;
  font-size:10px;
}
body.dpod-redesign-case-page .ccc-menu-schematic {
  width:62%;
  margin:26px auto 0;
  padding:12px;
  border:1px solid #d8d4d1;
  border-radius:8px;
  background:#fff;
}
body.dpod-redesign-case-page .ccc-menu-schematic i {
  display:block;
  height:8px;
  margin:8px 0;
  border-radius:6px;
  background:#dedbd8;
}
body.dpod-redesign-case-page .ccc-account-schematic {
  position:relative;
  height:120px;
  margin-top:24px;
  padding-left:34%;
  border:1px solid #d8d4d1;
  border-radius:8px;
  background:#fff;
}
body.dpod-redesign-case-page .ccc-account-schematic i {
  position:absolute;
  left:0; top:0; bottom:0;
  width:30%;
  border-right:1px solid #e0dcda;
  background:#f0eeec;
}
body.dpod-redesign-case-page .ccc-account-schematic em {
  display:block;
  height:11px;
  margin:20px 20px 0;
  border-radius:6px;
  background:#ddd9d6;
}

body.dpod-redesign-case-page .ccc-preserve-section {
  margin-top:80px;
  padding-top:70px;
  border-top:1px solid #ddd9d6;
}
body.dpod-redesign-case-page .ccc-preserve-note {
  margin:20px 0 0;
  color:#171717;
  font-size:15px;
  font-weight:650;
}
body.dpod-redesign-case-page .ccc-preserve-gallery {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:30px;
  margin-top:36px;
}
body.dpod-redesign-case-page .ccc-preserve-gallery .ccc-workflow {
  margin:0;
  padding:0;
  border:0;
}
body.dpod-redesign-case-page .ccc-preserve-gallery .ccc-workflow h2 {
  font-size:17px;
}
body.dpod-redesign-case-page .ccc-preserve-gallery .ccc-workflow img {
  margin-top:16px;
  border-radius:14px;
}

body.dpod-redesign-case-page .ccc-system-loop-final {
  margin-top:32px;
}

@media (max-width: 900px) {
  body.dpod-redesign-case-page .ccc-audit-3col,
  body.dpod-redesign-case-page .ccc-option-grid,
  body.dpod-redesign-case-page .ccc-compact-tradeoff,
  body.dpod-redesign-case-page .ccc-preserve-gallery { grid-template-columns:1fr; }
  body.dpod-redesign-case-page .ccc-system-loop {
    grid-template-columns:1fr;
  }
  body.dpod-redesign-case-page .ccc-system-loop > i {
    transform:rotate(90deg);
    justify-self:center;
  }
  body.dpod-redesign-case-page .ccc-account-placeholder {
    grid-template-columns:1fr;
  }
  body.dpod-redesign-case-page .ccc-account-placeholder > b {
    justify-self:center;
    transform:rotate(90deg);
  }
  body.dpod-redesign-case-page .ccc-hmw-block p { font-size:22px; }
  body.dpod-redesign-case-page .ccc-decision-block > h2,
  body.dpod-redesign-case-page .ccc-preserve-section > h2 { font-size:27px; }
}
